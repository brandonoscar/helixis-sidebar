{
  "name": "Occupella Copilot",
  "description": "Your AI copilot side panel.",
  "version": "0.3.0",
  "manifest_version": 3,
  "permissions": ["sidePanel", "tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service_worker.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Occupella Copilot" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "exclude_matches": [
      "*://*.managebuilding.com/*",
      "*://*.rentvine.com/*",
      "*://*.rentmanager.com/*",
      "*://*.propertyware.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
